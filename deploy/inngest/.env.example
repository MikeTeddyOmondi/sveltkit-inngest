# Copy to .env on thanos (~/src/inngest/.env) and fill in.

# Mutual auth keys — generate once and reuse on BOTH the Inngest server and the
# SvelteKit app:
#   INNGEST_EVENT_KEY=$(openssl rand -hex 16)
#   INNGEST_SIGNING_KEY=$(openssl rand -hex 32)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Postgres password (used by both the postgres service and the --postgres-uri).
POSTGRES_PASSWORD=inngest

# URL the Inngest server uses to reach your SvelteKit app's serve handler.
# Must be reachable from inside this Docker network / homelab.
# e.g. http://academy:3000/api/inngest  or  http://host.docker.internal:3000/api/inngest
INNGEST_SDK_URL=http://host.docker.internal:3000/api/inngest
