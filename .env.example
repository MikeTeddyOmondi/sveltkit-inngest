# Copy this to .env and fill in your values

# MongoDB
MONGODB_URI=mongodb://mongo:password@127.0.0.1:27017/locci-auth?authSource=admin

# Better Auth — generate with: openssl rand -hex 32
BETTER_AUTH_SECRET=0c4253e8ca3aa7bbb79b048282d8ff3a7b2f4c6fef30afadbfc01235a7095d6e
BETTER_AUTH_URL=http://localhost:5173

# Keycloak
# The realm issuer URL — e.g. https://auth.locci.cloud/realms/locci
KEYCLOAK_ISSUER=http://localhost:5080/realms/locci
KEYCLOAK_CLIENT_ID=locci-auth
KEYCLOAK_CLIENT_SECRET=JkFzIBBz0BgKuWL9cqcwlORSt7xch0xT

# Inngest
# Local dev: set INNGEST_DEV=1 so the SDK talks to the Dev Server (inngest dev).
# Leave it unset/0 in production.
INNGEST_DEV=1
# Production only — generate with:
#   INNGEST_EVENT_KEY=$(openssl rand -hex 16)
#   INNGEST_SIGNING_KEY=$(openssl rand -hex 32)
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=
# Base URL of the self-hosted Inngest server the SDK sends events to (prod).
# INNGEST_BASE_URL=http://inngest:8288
# Origin the Inngest server calls back to in order to RUN functions. Must be
# reachable from the server — use this app's LAN/public URL (NOT localhost) when
# the server runs on another host. In prod, your Cloudflare Tunnel hostname.
# INNGEST_SERVE_HOST=http://192.168.0.16:5173
# Slack webhook used by the onboarding workflow's fan-out step. In dev this is
# emulated by our own /api/mock/slack endpoint (use an absolute URL reachable
# from wherever the function runs). In prod, a real Slack incoming webhook.
# SLACK_WEBHOOK=http://192.168.0.16:5173/api/mock/slack
